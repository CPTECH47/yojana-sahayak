{
  "name": "yojana-sahayak",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite --host 127.0.0.1",
    "build": "vite build",
    "test": "node --test",
    "check:release": "node scripts/release-check.mjs",
    "test:ingest": "python -m unittest discover -s scripts -p test_*.py",
    "start": "node server/index.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.0.0",
    "@whiskeysockets/baileys": "^6.7.24",
    "dotenv": "^18.0.9",
    "express": "^5.0.0",
    "pino": "^9.14.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
