SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
PORT=3000
HOST=127.0.0.1
OLLAMA_URL=http://127.0.0.1:11434/api/chat
OLLAMA_MODEL=qwen3:4b
# Set a strong API_ACCESS_TOKEN before binding beyond localhost.
# Keep absolute state/auth paths stable across bot restarts. Never copy an active session.
# YOJANA_STATE_DIR=C:/private/yojana-state
# YOJANA_AUTH_DIR=C:/private/yojana-auth
# Experimental consenting-test alerts only. Public deployment requires approved transport.
YOJANA_TEST_ALERTS=0
# The Baileys role menu compares reviewed schemes by default; 0 retains the older single-scheme route.
YOJANA_MULTI_SCHEME=1
# Voice notes are processed locally unless the optional Sarvam provider is selected.
# YOJANA_STT_PROVIDER=sarvam
# SARVAM_API_KEY=put-your-key-in-your-private-.env-only
